# ==============================================================================
# Career & Portfolio AI Agent (.env.example)
# 복사해서 `.env` 파일을 만든 뒤 CHANGE_ME 값을 채워 사용하세요.
# 절대 실제 비밀번호나 키를 `.env.example`에 적지 마세요. (상세: SECRETS.md)
# ==============================================================================

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=career_agent
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=career_agent_db
DATABASE_URL=postgresql+psycopg://career_agent:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/career_agent_db

# --- AWS Bedrock ---
# EC2 운영 환경에서는 IAM Role을 사용하므로 AWS_ACCESS_KEY_ID/SECRET을 설정하지 않습니다.
# 로컬 개발 시에는 ~/.aws 프로파일(AWS_PROFILE)을 권장합니다.
AWS_REGION=us-east-1
# AWS_PROFILE=default

BEDROCK_FAST_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_SMART_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024

# --- Optional: GitHub Integration & Secret Encryption ---
# APP_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_FOR_TOKEN_ENCRYPTION
# GITHUB_TOKEN=

# --- App Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=80
